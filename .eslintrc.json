{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "airbnb-base"
    ],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "global-require": "off",
        "import/no-commonjs": "off",
        "import/extensions": [
            "error",
            "ignorePackages",
            {
                "js": "always",
                "mjs": "always"
            }
        ]
    },
    "overrides": [
        {
            "files": [
                "**/*.test.js"
            ],
            "env": {
                "jest": true
            }
        }
    ]
}
